# Налаштування MariaDB, потрібні платформі SOLPARTS.
# Керується Ansible-роллю sol_server_baseline — правки руками буде затерто.

[mysqld]
# Немає STRICT_TRANS_TABLES: легасі-шар каталогу подекуди покладається на м'яку
# поведінку (обрізання задовгих значень, неявні дефолти). Зі строгим режимом
# такий запис перетворюється на помилку і ламає імпорт прайсів.
sql_mode = ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Прайси й вивантаження каталогу йдуть великими пакетами.
max_allowed_packet = {{ sol_mariadb_max_allowed_packet }}

# ─── InnoDB ───────────────────────────────────────────────────────────────────
# Сервер піднімається повністю на InnoDB: там живуть каталог, замовлення і
# контент. Похідні таблиці розкладки товарів лишаються MyISAM — вони цілком
# перегенеровуються збіркою, тож crash-safety їм не потрібна, а перебудова йде
# через тіньову таблицю з наступним RENAME, без локів на бойовій.
#
# Усі параметри цієї секції статичні й діють з першого старту служби, тому
# новий сервер отримує цільовий стан без окремого рестарту.

# Буферизований I/O замість O_DIRECT (дефолт MariaDB 10.6+). Сторінки, що не
# влізли в buffer pool, лишаються в page cache ядра — пул працює як гаряче
# ядро, а весь вільний RAM машини служить спільним дисковим кешем. З O_DIRECT
# page cache для БД невидимий: кожен промах пулу стає фізичним читанням, а
# компенсувати це можна лише роздуванням пулу — тобто анонімної пам'яті, яку
# ядро не може віддати під тиском і яку першою забирає OOM-killer.
innodb_flush_method = fsync

# Гаряче ядро, а не основний кеш даних (див. flush_method вище).
innodb_buffer_pool_size = {{ sol_mariadb_innodb_buffer_pool_size }}
innodb_file_per_table = 1

# Дефолтні 96M упираються у форсовані checkpoint-и, щойно починається масовий
# запис імпорту прайсів.
innodb_log_file_size = 512M

# Стеля кешу вставок FULLTEXT на всі таблиці разом. Кеш накопичує токени нових
# рядків до скидання на диск і живе в анонімній пам'яті, тож дефолтні 640M
# роздувають процес саме у вікні масового запису в таблиці з FT-індексом.
# Менша стеля означає частіший фоновий sync індексу, а не помилку.
innodb_ft_total_cache_size = 128M

# Токенізація FULLTEXT лишається на дефолтах (InnoDB індексує токени від трьох
# символів зі стандартним стоп-листом). Пошук по каталогу обслуговує
# Meilisearch, а SQL-FT лишився на службових вибірках, яким короткі токени не
# потрібні; зниження порога коштувало б окремого запису в індексі на кожну
# літеру й цифру.
